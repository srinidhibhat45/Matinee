{
  "expo": {
    "name": "Matinee",
    "slug": "matinee",
    "owner": "srinidhibhat45",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "matinee",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7802f26a-0f5a-48d0-8669-7a54f315bb7b",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.matinee.app",
      "adaptiveIcon": {
        "backgroundColor": "#181213",
        "foregroundImage": "./assets/images/icon.png"
      },
      "permissions": [
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF8F7",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#181213"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#B80F55"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      "expo-updates",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7802f26a-0f5a-48d0-8669-7a54f315bb7b"
      }
    }
  }
}
